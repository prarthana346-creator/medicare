# ====================================================
# MEDICARE HOSPITAL MANAGEMENT SYSTEM - ENVIRONMENT
# ====================================================

FLASK_ENV=development
SECRET_KEY=medicare-super-secret-production-key-2026
JWT_SECRET_KEY=medicare-jwt-secret-key-medical-app-2026
JWT_ACCESS_HOURS=12
PORT=5000

# PostgreSQL Database Connection
# Example URL for local PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medicare_db

# Fallback to local SQLite if PostgreSQL service is not reachable
USE_SQLITE_FALLBACK=true

# Frontend Configuration (optional override)
VITE_API_URL=http://localhost:5000/api

