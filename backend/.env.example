# Medicare Flask Backend Environment Variables
FLASK_ENV=development
SECRET_KEY=medicare-super-secret-key-change-in-production
JWT_SECRET_KEY=medicare-jwt-secret-key-production-ready
JWT_ACCESS_HOURS=12
PORT=5000

# Database Configuration:
# PostgreSQL URL format:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/medicare_db
# Set USE_SQLITE_FALLBACK=true to automatically fallback to local sqlite if postgres is not available
USE_SQLITE_FALLBACK=true

